# SKYGUARD / Project Furnace — copy to skyguard.env and edit.
# Never commit real passwords, API keys, or Tailscale auth keys.

SKYGUARD_EMULATION=true
ENABLE_BLACKBOX=true
ENABLE_FUSION=true
ENABLE_PIXEL_TRACKER=false
ENABLE_PTZ_TRACKER=false

BLACKBOX_HOST=127.0.0.1
BLACKBOX_PORT=9090
# Leave empty to use furnace/logs/furnace_sigint.log
SSD_LOG_PATH=

RTSP_URL=rtsp://CAMERA_HOST:554/stream1
HUD_HOST=127.0.0.1
HUD_PORT=9091

PTZ_CAMERA_IP=CAMERA_HOST
PTZ_CAMERA_USER=admin
PTZ_CAMERA_PASSWORD=

# Optional — engine works offline without a key
GEMINI_API_KEY=

# Reference origin (example: Arnhem area). Change for your site.
REF_LAT=51.9851
REF_LON=5.8987
REF_ALT=110.0

EVIDENCE_HOST=127.0.0.1
EVIDENCE_PORT=8765
# SKYGUARD_NODES_JSON defaults to furnace/config/nodes.json
